# --- Application ---
APP_ENV=development
APP_SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/destrucyion

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram API (from https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Telegram Bot (from @BotFather) ---
BOT_TOKEN=
# List of Telegram user IDs (comma-separated or JSON list) authorized to use /admin commands
ADMIN_TELEGRAM_IDS=

# --- Session encryption (Telethon sessions are encrypted with this key) ---
SESSION_ENCRYPTION_KEY=

# --- Public web login ---
# Public HTTPS base URL used for one-time Telegram phone-login links.
WEB_BASE_URL=http://localhost:8000

# --- Webhook security (for the Telegram Bot webhook on Vercel) ---
WEBHOOK_SECRET=

# --- Optional ---
LOG_LEVEL=INFO
SENTRY_DSN=

# Never commit a filled-in .env file.

# --- Media capture behaviour (mirrors the original Saveit.py options) ---
# If true (default), only incoming timed/self-destructing media is saved
# automatically. If false, every incoming photo/video/document/voice is
# saved — this floods Saved Messages in busy chats, not recommended.
CAPTURE_ONLY_TIMED=true

# Manual save trigger (Saveit's HANDLER). Reply to any media message with
# this exact text (from the account owner) to save it on demand, regardless
# of CAPTURE_ONLY_TIMED. Leave empty to disable the manual trigger entirely.
SAVE_TRIGGER=.saveit

# --- Timestamp display (captions & admin notifications) ---
# IANA timezone name. Telegram exposes NO per-user timezone anywhere in its
# API — this is a single operator-configured display timezone, not a true
# per-viewer automatic one.
DISPLAY_TIMEZONE=UTC

# --- Admin notifications (operator's private channel/chat) ---
# If set, every captured media item also sends a richer notification here:
# the media sender's identity + the connected customer's own telegram_id,
# username, FULL phone number (decrypted — explicit operator choice, see
# CLAUDE.md), and subscription plan/status/expiry. The bot account must be
# a member/admin of this chat. Leave unset to disable entirely.
ADMIN_NOTIFY_CHAT_ID=

# --- DOKU (Sandbox / Dynamic QRIS POC) ---
# DOKU Sandbox Client ID / BRN from DOKU Dashboard
DOKU_CLIENT_ID=
# DOKU Sandbox Active Secret Key
DOKU_SECRET_KEY=
# Keep sandbox while testing. Production will use https://api.doku.com
DOKU_IS_PRODUCTION=false
DOKU_BASE_URL=https://api-sandbox.doku.com
# Public HTTPS endpoint receiving DOKU payment notifications
DOKU_NOTIFICATION_URL=

# --- Midtrans ---
# Sandbox credentials from Midtrans Dashboard
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Set true only when using Midtrans Production credentials/endpoints.
# Keep false while testing with Midtrans Sandbox.
MIDTRANS_IS_PRODUCTION=false

# Public HTTPS endpoint receiving Midtrans notifications
MIDTRANS_NOTIFICATION_URL=

# Optional URLs shown after payment
MIDTRANS_FINISH_URL=
MIDTRANS_UNFINISH_URL=
MIDTRANS_ERROR_URL=

# --- NOWPayments (crypto payment provider; initial target: USDT on TRON/TRC20) ---
# Runtime currently uses the PRODUCTION variables below. Sandbox variables are
# documented separately but will NOT be used until the application code adds
# an explicit environment selector and separate sandbox credentials.
NOWPAYMENTS_ENVIRONMENT=production

# SANDBOX credentials from the NOWPayments sandbox dashboard.
# These are intentionally separate from production credentials.
NOWPAYMENTS_SANDBOX_API_KEY=
NOWPAYMENTS_SANDBOX_IPN_SECRET=
NOWPAYMENTS_SANDBOX_BASE_URL=https://api-sandbox.nowpayments.io/v1

# PRODUCTION credentials from your live NOWPayments account.
# API key from your NOWPayments account. Never commit the real key.
NOWPAYMENTS_API_KEY=
# IPN Secret Key from NOWPayments Store Settings; used to verify webhook signatures.
# This is different from the API key. Never commit the real secret.
NOWPAYMENTS_IPN_SECRET=
# Public HTTPS URL for the NOWPayments IPN/webhook endpoint.
NOWPAYMENTS_IPN_CALLBACK_URL=
# Optional payout destinations: only destinations with configured addresses and live NOWPayments support appear in the bot.
# Format: currency_code=wallet_address,currency_code=wallet_address (use addresses you control and verify each network).
# Codes used by this project:
#   ethbase=ETH Base, usdcbase=USDC Base, trx=TRX (TRON), bnbbsc=BNB (BSC),
#   sol=Solana (SOL), eth=ETH Mainnet, usdttrc20=USDT-TRX, usdtbsc=USDT-BSC,
#   usdtsol=USDT-Solana, usdt=USDT-ETH (ERC20).
# Configure only the networks for which you have a valid destination wallet:
NOWPAYMENTS_PAYOUT_ADDRESSES=usdcbase=YOUR_USDC_BASE_ADDRESS
# Example containing all requested destinations (replace EVERY placeholder with your own valid address):
# NOWPAYMENTS_PAYOUT_ADDRESSES=ethbase=YOUR_ETH_BASE_ADDRESS,usdcbase=YOUR_USDC_BASE_ADDRESS,trx=YOUR_TRON_ADDRESS,bnbbsc=YOUR_BSC_ADDRESS,sol=YOUR_SOLANA_ADDRESS,eth=YOUR_ETH_MAINNET_ADDRESS,usdttrc20=YOUR_USDT_TRC20_ADDRESS,usdtbsc=YOUR_USDT_BEP20_ADDRESS,usdtsol=YOUR_USDT_SOLANA_ADDRESS,usdt=YOUR_USDT_ERC20_ADDRESS
# NOWPayments pay_currency code for USDT on TRON. Confirm availability in your account.
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# Production API base URL; keep this for production credentials only.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

SUBSCRIPTION_WEEKLY_PRICE=8000
SUBSCRIPTION_MONTHLY_PRICE=30000
SUBSCRIPTION_3_MONTHLY_PRICE=90000
SUBSCRIPTION_LIFETIME_PRICE=2000000