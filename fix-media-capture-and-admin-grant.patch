+    """/admin revoke <telegram_id>"""
+    args = context.args[1:]
+    if len(args) != 1:
+        await update.message.reply_text("Usage: /admin revoke <telegram_id>")
+        return
+
+    target = await _find_target_user(update, session, args[0])
+    if target is None:
+        return
+
+    try:
